#!/usr/bin/env bash
# Claude Code rate-limit segment for the tmux status line: session (5h) and
# weekly utilisation, as percentages.
#
# Prints NOTHING, and exits 0, unless the data is genuinely available -- no
# claude install, no credentials, no curl, a failed or unparsable fetch all
# render an empty segment rather than an error or a stale-looking zero.
#
# The status line re-runs this every status-interval, so it never performs the
# network call inline: it serves whatever is cached and refreshes in the
# background. A tick with no cache yet prints nothing and the segment simply
# appears a tick later.
set -uo pipefail

CREDS="$HOME/.claude/.credentials.json"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}"
CACHE="$CACHE_DIR/tmux-claude-usage.json"
LOCK="$CACHE_DIR/tmux-claude-usage.lock"
ENDPOINT="https://api.anthropic.com/api/oauth/usage"

FRESH_SECS=300     # younger than this: serve as is, no refresh. The endpoint
                   # rate-limits, and a 5-hour window does not need finer
                   # granularity than this.
MAX_AGE_SECS=900   # older than this: treat as unusable and hide

age_of() { echo $(( $(date +%s) - $(stat -c %Y "$1" 2>/dev/null || echo 0) )); }

# --- internal: fetch and atomically replace the cache -----------------------
if [ "${1:-}" = "--refresh" ]; then
    mkdir -p "$CACHE_DIR"
    exec 9>"$LOCK" || exit 0
    flock -n 9 || exit 0          # a refresh is already in flight

    token=$(python3 -c "
import json,sys
try:
    print(json.load(open(sys.argv[1]))['claudeAiOauth']['accessToken'])
except Exception:
    sys.exit(1)
" "$CREDS" 2>/dev/null) || exit 0
    [ -n "$token" ] || exit 0

    # Token goes in via stdin config, never argv, so it cannot leak into ps.
    body=$(printf 'url = "%s"\nheader = "Authorization: Bearer %s"\nheader = "anthropic-beta: oauth-2025-04-20"\n' \
             "$ENDPOINT" "$token" |
           curl -sS --max-time 10 -K - 2>/dev/null) || exit 0
    unset token

    # Only replace the cache with something that actually parses and carries
    # the two windows we render.
    printf '%s' "$body" | python3 -c "
import json, sys, datetime
d = json.load(sys.stdin)
out = {}
for k in ('five_hour','seven_day'):
    w = d.get(k)
    if not isinstance(w, dict) or w.get('utilization') is None:
        sys.exit(1)
    out[k] = round(float(w['utilization']))
    r = w.get('resets_at')
    if r:
        try:
            out[k + '_reset'] = int(datetime.datetime.fromisoformat(r).timestamp())
        except Exception:
            pass
json.dump(out, sys.stdout)
" > "$CACHE.tmp" 2>/dev/null && mv "$CACHE.tmp" "$CACHE" || rm -f "$CACHE.tmp"
    exit 0
fi

# --- render -----------------------------------------------------------------
# Hide entirely unless every prerequisite is present.
command -v claude  >/dev/null 2>&1 || exit 0
command -v curl    >/dev/null 2>&1 || exit 0
command -v python3 >/dev/null 2>&1 || exit 0
[ -r "$CREDS" ] || exit 0

if [ ! -f "$CACHE" ] || [ "$(age_of "$CACHE")" -ge "$FRESH_SECS" ]; then
    setsid "$0" --refresh >/dev/null 2>&1 &   # detached: never blocks the status line
fi

[ -f "$CACHE" ] || exit 0
[ "$(age_of "$CACHE")" -lt "$MAX_AGE_SECS" ] || exit 0

# Reset fields are read with a default of 0 so a cache written by an older
# version of this script still renders, just without the countdowns.
read -r five seven five_reset seven_reset < <(python3 -c "
import json,sys
try:
    d = json.load(open(sys.argv[1]))
    print(int(d['five_hour']), int(d['seven_day']),
          int(d.get('five_hour_reset') or 0), int(d.get('seven_day_reset') or 0))
except Exception:
    pass
" "$CACHE" 2>/dev/null)
[ -n "${five:-}" ] && [ -n "${seven:-}" ] || exit 0

# Time until a window resets, coarsened to two units. Prints nothing for a
# missing timestamp or one already in the past, so a stale cache shows the
# percentages alone rather than a negative countdown.
until_reset() {
    local target=${1:-0} now diff d h m
    [ "$target" -gt 0 ] || return 0
    now=$(date +%s)
    diff=$(( target - now ))
    [ "$diff" -gt 0 ] || return 0
    d=$(( diff / 86400 )); h=$(( diff % 86400 / 3600 )); m=$(( diff % 3600 / 60 ))
    if   [ "$d" -gt 0 ]; then printf ' (%dd%dh)' "$d" "$h"
    elif [ "$h" -gt 0 ]; then printf ' (%dh%dm)' "$h" "$m"
    else                      printf ' (%dm)' "$m"
    fi
}

worst=$(( five > seven ? five : seven ))

# Colour is a signal, not decoration: normal usage renders in the bar's own
# foreground and only an elevated number takes on colour, so anything coloured
# in this segment means something.
#
# Deliberately NOT a filled block. The neighbouring hostname block is
# bg=#a6e3a1, and an "all is well" green block next to it merged into one
# continuous green bar with no visible boundary.
dim='#6c7086'
if   [ "$worst" -ge 80 ]; then value='#f38ba8'; emphasis=',bold'
elif [ "$worst" -ge 50 ]; then value='#f9e2af'; emphasis=''
else                           value='#cdd6f4'; emphasis=''
fi

printf '#[bg=#1e1e2e,fg=%s] claude  session #[fg=%s%s]%d%%#[default,bg=#1e1e2e,fg=%s]%s  week #[fg=%s%s]%d%%#[default,bg=#1e1e2e,fg=%s]%s ' \
       "$dim" "$value" "$emphasis" "$five"  "$dim" "$(until_reset "$five_reset")" \
       "$value" "$emphasis" "$seven" "$dim" "$(until_reset "$seven_reset")"
